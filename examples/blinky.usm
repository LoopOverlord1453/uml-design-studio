{
  "schema": 1,
  "type": "state_machine",
  "name": "Blinky",
  "prefix": "blinky",
  "description": "LED blink controller: an example of hierarchy, choice and an error counter.",
  "context_type": "blinky_ctx_t",
  "user_includes": "#include \"blinky_ctx.h\"",
  "states": [
    {
      "id": "s_init",
      "name": "Start",
      "kind": "initial",
      "parent": null,
      "entry": "",
      "exit": "",
      "do": "",
      "x": 106,
      "y": 30,
      "w": 24,
      "h": 24,
      "note": ""
    },
    {
      "id": "s_run",
      "name": "Running",
      "kind": "composite",
      "parent": null,
      "entry": "ctx->blink_count = 0U;",
      "exit": "led_write(false);",
      "do": "ctx->uptime_ticks++;",
      "x": 400,
      "y": 40,
      "w": 560,
      "h": 250,
      "note": "Blink cycle. A FAULT event bumps the counter (internal transition)."
    },
    {
      "id": "s_run_init",
      "name": "RunStart",
      "kind": "initial",
      "parent": "s_run",
      "entry": "",
      "exit": "",
      "do": "",
      "x": 46,
      "y": 48,
      "w": 24,
      "h": 24,
      "note": ""
    },
    {
      "id": "s_on",
      "name": "LedOn",
      "kind": "simple",
      "parent": "s_run",
      "entry": "led_write(true);",
      "exit": "",
      "do": "",
      "x": 30,
      "y": 100,
      "w": 170,
      "h": 78,
      "note": ""
    },
    {
      "id": "s_offled",
      "name": "LedOff",
      "kind": "simple",
      "parent": "s_run",
      "entry": "led_write(false);",
      "exit": "",
      "do": "",
      "x": 360,
      "y": 100,
      "w": 170,
      "h": 78,
      "note": ""
    },
    {
      "id": "s_off",
      "name": "Off",
      "kind": "simple",
      "parent": null,
      "entry": "led_write(false);",
      "exit": "",
      "do": "",
      "x": 40,
      "y": 90,
      "w": 170.0,
      "h": 84.0,
      "note": "LED off; the button starts the blink cycle."
    },
    {
      "id": "s_done",
      "name": "Done",
      "kind": "final",
      "parent": null,
      "entry": "",
      "exit": "",
      "do": "",
      "x": 1020,
      "y": 150,
      "w": 30,
      "h": 30,
      "note": ""
    },
    {
      "id": "s_check",
      "name": "Check",
      "kind": "choice",
      "parent": null,
      "entry": "",
      "exit": "",
      "do": "",
      "x": 250,
      "y": 300,
      "w": 38,
      "h": 38,
      "note": ""
    },
    {
      "id": "s_fault",
      "name": "Fault",
      "kind": "simple",
      "parent": null,
      "entry": "fault_signal(true);",
      "exit": "fault_signal(false);",
      "do": "",
      "x": 40,
      "y": 410,
      "w": 170.0,
      "h": 84.0,
      "note": "Repeated faults: waiting for RESET."
    }
  ],
  "transitions": [
    {
      "id": "t_init",
      "source": "s_init",
      "target": "s_off",
      "event": "",
      "guard": "",
      "action": "",
      "kind": "external",
      "priority": 0,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    },
    {
      "id": "t_fault",
      "source": "s_run",
      "target": "s_run",
      "event": "FAULT",
      "guard": "",
      "action": "ctx->error_count++;",
      "kind": "internal",
      "priority": 0,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    },
    {
      "id": "t_shutdown",
      "source": "s_run",
      "target": "s_done",
      "event": "SHUTDOWN",
      "guard": "",
      "action": "system_halt();",
      "kind": "external",
      "priority": 0,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    },
    {
      "id": "t_stop",
      "source": "s_run",
      "target": "s_check",
      "event": "BUTTON",
      "guard": "",
      "action": "",
      "kind": "external",
      "priority": 0,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    },
    {
      "id": "t_run_init",
      "source": "s_run_init",
      "target": "s_on",
      "event": "",
      "guard": "",
      "action": "",
      "kind": "external",
      "priority": 0,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    },
    {
      "id": "t_blink_off",
      "source": "s_on",
      "target": "s_offled",
      "event": "TICK",
      "guard": "",
      "action": "",
      "kind": "external",
      "priority": 0,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    },
    {
      "id": "t_blink_on",
      "source": "s_offled",
      "target": "s_on",
      "event": "TICK",
      "guard": "",
      "action": "ctx->blink_count++;",
      "kind": "external",
      "priority": 0,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    },
    {
      "id": "t_start",
      "source": "s_off",
      "target": "s_run",
      "event": "BUTTON",
      "guard": "",
      "action": "",
      "kind": "external",
      "priority": 0,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    },
    {
      "id": "t_chk_fault",
      "source": "s_check",
      "target": "s_fault",
      "event": "",
      "guard": "ctx->error_count > 3U",
      "action": "",
      "kind": "external",
      "priority": 0,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    },
    {
      "id": "t_chk_off",
      "source": "s_check",
      "target": "s_off",
      "event": "",
      "guard": "else",
      "action": "",
      "kind": "external",
      "priority": 1,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    },
    {
      "id": "t_reset",
      "source": "s_fault",
      "target": "s_off",
      "event": "RESET",
      "guard": "",
      "action": "ctx->error_count = 0U;",
      "kind": "external",
      "priority": 0,
      "waypoints": [],
      "label_dx": 0.0,
      "label_dy": -16.0
    }
  ]
}
